# Eshitaman Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=Eshitaman
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (for future use)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eshitaman

# Redis (for future use)
# REDIS_URL=redis://localhost:6379/0

# JWT (for future use)
# SECRET_KEY=your-secret-key-here
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# STT Configuration
STT_PROVIDER=mock
STT_API_KEY=your-stt-api-key-here
STT_API_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
STT_TIMEOUT_SECONDS=60.0
STT_MAX_RETRIES=3
# Optional: leave empty for automatic multilingual detection (Uzbek, Russian, English)
STT_LANGUAGE_HINT=

# LLM / AI Understanding Configuration (options: mock, groq, openai)
LLM_PROVIDER=mock
LLM_API_KEY=your-llm-api-key-here
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3
LLM_MAX_CHUNK_CHARACTERS=16000

# Groq Configuration (Stage 10 Competition MVP)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Embedding & Vector Database (Stage 9 RAG)
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT_SECONDS=30.0
EMBEDDING_MAX_RETRIES=3

# Vector Store
VECTOR_STORE_TYPE=memory
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eshitaman

# RAG Parameters
RAG_CHUNK_MAX_TOKENS=250
RAG_CHUNK_OVERLAP_TOKENS=40
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.20